{
  "name": "campus-sports-venue-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --build",
    "lint:check": "eslint . --max-warnings 0",
    "test:unit:run": "vitest run",
    "build": "vite build",
    "test:e2e:contract": "vitest run --config tests/e2e/vitest.e2e.config.ts --project contract-http",
    "test:e2e:walkthrough": "vitest run --config tests/e2e/vitest.e2e.config.ts --project walkthrough",
    "test:e2e:cors": "vitest run --config tests/e2e/vitest.e2e.config.ts --project cors",
    "test:e2e:tour": "vitest run --config tests/e2e/vitest.e2e.config.ts --project tour",
    "test:e2e:timed": "vitest run --config tests/e2e/vitest.e2e.config.ts --project timed",
    "test:e2e:tools": "vitest run --config tests/e2e/vitest.e2e.config.ts --project tools"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
