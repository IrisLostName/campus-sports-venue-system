{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "src/api/**/*.ts",
    "src/utils/**/*.ts",
    "src/stores/**/*.ts",
    "src/composables/**/*.ts",
    "src/router/**/*.ts",
    "src/components/**/*.vue",
    "src/components/display/*.ts",
    "src/views/**/*.vue",
    "src/views/display/*.ts"
  ],
  "exclude": ["src/router/index.ts"]
}
