# 本地开发用环境变量示例（复制为 backend/.env 后使用；.env 不入库）
# 仅为本地开发值，真实环境必须替换。
# 本地一般使用 SPRING_PROFILES_ACTIVE=demo（追加演示种子数据）。
# profile 必须写在系统环境变量或 IDE 运行配置里（.env 在 profile 确定之后才被读取，对它无效）：
#   PowerShell：$env:SPRING_PROFILES_ACTIVE="demo"
# 开发库一旦执行过 V100 演示种子，之后不带 demo 启动会被 Flyway 校验拒绝，这是预期行为。
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/venue_booking
DB_USERNAME=venue
DB_PASSWORD=venue_dev_pwd

# 自动化测试使用独立的测试库，库名必须以 _test 结尾（否则测试拒绝清库）
TEST_DB_URL=jdbc:postgresql://localhost:5432/venue_booking_test
TEST_DB_USERNAME=venue
TEST_DB_PASSWORD=venue_dev_pwd

# JWT 签名密钥：至少 32 字节（UTF-8）的随机串，无默认值；缺失或过短时应用拒绝启动。
# 自行生成（例如 48 位随机字母数字），只写在不入库的 backend/.env 里，禁止提交到仓库。
JWT_SECRET=
# JWT_EXPIRE_HOURS=8
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Shanghai

# 预约参数都有默认值，只有需要改动时才设置
# BOOKING_ADVANCE_DAYS=7
# BOOKING_CANCEL_DEADLINE_MINUTES=120
# BOOKING_CHECKIN_OPEN_BEFORE_MINUTES=15
# BOOKING_CHECKIN_CLOSE_AFTER_MINUTES=15
# BOOKING_CHECKOUT_GRACE_MINUTES=30
# BOOKING_MAX_ACTIVE_PER_USER=3
